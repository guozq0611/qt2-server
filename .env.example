# qt2-server 配置模板
# 复制此文件为 .env 并填写真实值（.env 已被 gitignore，不会提交）

# 启用的行情网关（逗号分隔，按顺序启动）
GATEWAYS=ctp

# CTP 行情前置机地址
CTP_MD_FRONT_ADDRESS=tcp://101.231.162.58:41213
# CTP 订阅的交易所列表（逗号分隔）
CTP_SUBSCRIBE_EXCHANGES=CFFEX,SHFE,DCE,CZCE,INE,GFEX
# CTP 订阅的资产类型（逗号分隔：FUTURE / OPTION）
CTP_SUBSCRIBE_ASSET_TYPES=FUTURE

# 数据库（合约信息、交易日历）
# DB_TYPE 支持: mysql / postgres / ob(OceanBase, 兼容 MySQL 协议)
DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Redis（监控上报、最新行情快照）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ZeroMQ 行情广播
ZMQ_BIND_URL=tcp://*:5555

# 落盘根目录（相对于项目根，也可填绝对路径）
DATA_DIR=data/raw
